# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# --- Gmail ---
# Comma-separated aliases for the ONLY accounts to monitor, e.g. personal,work.
GMAIL_ACCOUNTS=personal,work
# One OAuth client (Desktop app) shared by every account.
GMAIL_CREDENTIALS_FILE=credentials.json
# Per-account tokens are stored here and ignored by git.
GMAIL_TOKEN_DIR=data/tokens
# Recent-inbox window. Read state is intentionally ignored so messages you
# open manually are still observed.
GMAIL_QUERY=in:inbox newer_than:1d
# Optional per-account query override (alias uppercased, '-' becomes '_').
# GMAIL_QUERY_WORK=in:inbox newer_than:2d
# Optional expected address per account; a mismatch aborts the command.
# GMAIL_ACCOUNT_PERSONAL_EMAIL=you@gmail.com
# GMAIL_ACCOUNT_WORK_EMAIL=you@company.com
# Maximum messages fetched per poll cycle (1-500).
GMAIL_FETCH_LIMIT=20

# --- Scheduler ---
POLL_INTERVAL_SECONDS=60

# --- Ollama (local AI, free) ---
# Ollama must be running locally; no email content leaves this machine.
# Pull the model once: ollama pull llama3.2
# The first request can include model loading; allow generous time.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=300

# --- Telegram notifications ---
# Get the token from @BotFather and the chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
# Find this with: python main.py telegram chats --limit 20
TELEGRAM_CHAT_ID=

# --- Storage ---
DATABASE_PATH=data/emails.db

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Classification ---
# Emails with an importance score >= this value are flagged by 'ai test' and
# will trigger a notification in Phase 5 (0-10). Genuine job-related email is
# always raised to at least this score and classified as IMPORTANT.
IMPORTANCE_THRESHOLD=7
